<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the ntfy server for crier pushes running. scripts/setup-push.sh
  installs it; to remove: launchctl bootout gui/$(id -u)/com.ianeff.crier-ntfy
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ianeff.crier-ntfy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/ntfy</string>
    <string>serve</string>
    <string>--config</string>
    <string>/Users/ian/.config/crier/ntfy.yml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ian/Library/Logs/crier-ntfy.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ian/Library/Logs/crier-ntfy.log</string>
</dict>
</plist>
