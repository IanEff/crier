<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs `crier run` every 20 minutes. crier itself skips runs outside
  digest.active_hours. Install:

    uv tool install --editable ~/projects/rc/crier
    cp launchd/com.ianeff.crier.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ianeff.crier.plist

  Run it now:   launchctl kickstart gui/$(id -u)/com.ianeff.crier
  Remove:       launchctl bootout gui/$(id -u)/com.ianeff.crier

  The log holds counts and error codes only, never message text.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ianeff.crier</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ian/.local/bin/crier</string>
    <string>run</string>
  </array>
  <key>StartInterval</key>
  <integer>1200</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ian/Library/Logs/crier.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ian/Library/Logs/crier.log</string>
</dict>
</plist>
